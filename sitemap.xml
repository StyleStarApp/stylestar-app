<?xml version="1.0" encoding="UTF-8"?>
<!--
  Style Star's real pages. Every one of these is a rewrite in netlify.toml
  (status 200) onto the single index.html, so the address is real even though
  the app is one file.

  ⚠️ DELIBERATELY ABSENT, both of them:
  · /results   — it opens the Style Portrait on a device that already has one
                 saved. To a crawler, which has none, it is byte-identical to
                 the home page, so listing it would offer Google a duplicate.
  · /list/*    — a woman's shared wishlist. The token IS the credential, so
                 these must never be advertised. They also carry noindex.

  ⚠️ The canonical host is the APEX, stylestar.app. www 301s to it (verified
  2026-08-24), so every URL here is written without www.

  ⚠️⚠️ KEEP <lastmod> HONEST — IT IS THE ONE FIELD THE CRAWLERS ACTUALLY USE.
  Google ignores changefreq and priority outright; lastmod is what tells it a
  page is worth re-crawling. Found stale on 2026-08-31: the home page and /faq
  still claimed 2026-08-24 after a week of real edits, which quietly argued
  AGAINST the re-index we were requesting by hand in Search Console.
  ▶ WHEN A PAGE'S CONTENT CHANGES, BUMP ITS DATE IN THE SAME COMMIT.
  ⚠️ And only the pages that really changed — bumping all eight to today is a
  false signal, and a sitemap that cries wolf gets trusted less, not more.
  (2026-08-28 is the route-trim + sitewide Organization schema, which changed
  the served HTML of every route. 2026-08-31 is the "brilliance of AI" sentence
  on the home page and in the FAQ, plus the reworked founder line.)
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://stylestar.app/</loc>
    <lastmod>2026-09-01</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://stylestar.app/story</loc>
    <lastmod>2026-08-28</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://stylestar.app/faq</loc>
    <lastmod>2026-08-31</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://stylestar.app/contact</loc>
    <lastmod>2026-08-28</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
  <!-- ⚠️ THE ONE PAGE ON THIS SITE WHERE A MOVING <lastmod> IS THE POINT.
       What's Trending competes on FRESHNESS: a magazine publishes a new trend
       article each season and the old one goes stale, while this is one page
       that stays current. That only works if the date tells the truth.
       ▶ BUMP THIS IN THE SAME COMMIT AS ANY TREND EDIT, and never bump it
       just to look freshly maintained, which is the crying-wolf problem the
       rule at the top of this file exists to prevent. changefreq is weekly
       here for the same reason; the crawlers ignore it, but it is honest.
       ⚠️ NO DOUBLE HYPHEN ANYWHERE INSIDE AN XML COMMENT: it is an invalid
       token and makes the whole sitemap unparseable. -->
  <url>
    <loc>https://stylestar.app/trending</loc>
    <lastmod>2026-09-03</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <!-- Your Wardrobe List, her 100-item closet-consultation checklist, given
       its own URL 2026-09-04. This lastmod moves rarely on purpose, since
       she pinned the list at 100 items the same day, so it should not need
       touching often. Bump it only if an item is genuinely added, removed
       or renamed (which also needs the matching edit in index.html's
       wardrobeItems AND page-titles.js's WARDROBE_ITEMS, see the comment
       above that constant). -->
  <url>
    <loc>https://stylestar.app/wardrobe</loc>
    <lastmod>2026-09-04</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://stylestar.app/journal</loc>
    <lastmod>2026-09-01</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://stylestar.app/journal/how-to-find-your-personal-style</loc>
    <lastmod>2026-08-28</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://stylestar.app/journal/how-to-dress-for-fall-in-florida</loc>
    <lastmod>2026-09-01</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://stylestar.app/privacy</loc>
