# Playwright is installed fresh each session to run the scratchpad render and
# verification harnesses. It is a local tool, never a project dependency, so
# neither it nor its lockfile belongs in the repo.
node_modules/
package-lock.json

# Retailer product photos pulled down so the render harnesses can serve them
# locally (this sandbox's Chromium cannot reach retail CDNs). ⚠️ NEVER commit
# these: the repo is public, and an affiliate approval licenses the APP to
# display a retailer's photo by hotlinking, not this repo to redistribute a
# copy of the file. scratchpad/starphoto.mjs re-fetches on demand.
scratchpad/dvf-scarf.jpg

# Generated by scratchpad/sharelist-mock.mjs at render time; regenerate, never commit.
scratchpad/_mock/

# render harness intermediates
scratchpad/_*.png
scratchpad/_*.html

# Suite run logs. These are REGENERATED on every run and are not a record: the
# record that matters is the total quoted in the commit message. Tracking them
# forces a choice between leaving the tree dirty and committing a HALF-WRITTEN
# log, and a partial log is worse than none -- it shows zero failure marks while
# proving nothing, which is exactly the false green this project has paid for
# once already (2026-08-22: a commit made on a run that had crashed on
# EADDRINUSE). READ THE TOTAL, from a finished run, in the terminal.
scratchpad/out-*.txt

# Before/after render sweeps for the CSS extraction (scratchpad/cssextract-render.mjs).
# ~170 MB of PNGs, regenerated on demand by running that harness twice -- and the
# comparison is the point, not the images. Same reasoning as the suite logs above.
scratchpad/cssx/

# Retailer product photos cached by scratchpad/photocache.mjs so the render
# harnesses can serve them locally. ⚠️ NEVER commit these: the repo is public,
# and an affiliate approval licenses the APP to hotlink a photo, not this repo
# to redistribute a copy of the file. Re-fetched on demand.
scratchpad/photos/

# Rakuten feed data — NEVER commit. This repo is public, and an affiliate approval
# licenses the APP to use a retailer's catalog, not this repo to redistribute it.
*.txt.gz
*.xml.gz
feeds/

# Python bytecode cache. Regenerated on every run of the feed scripts, so a
# tracked copy leaves the tree dirty after each test run and churns the diff
# for nothing. One got committed by accident in 37942a3 and is removed here.
__pycache__/
*.pyc
